# Rails defaults — see https://github.com/rails/rails/blob/main/railties/lib/rails/generators/rails/app/templates/gitignore.tt

# Ignore bundler config.
/.bundle

# Ignore the default SQLite database (we use Postgres but keep this for safety).
/db/*.sqlite3
/db/*.sqlite3-*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep

# Ignore master key for decrypting credentials and more.
/config/master.key

# Local environment files — contain secrets (Resend, JWT, DB). Unanchored so
# a stray secrets file in ANY dir (e.g. deploy/.env) is also ignored; only
# the committed templates are re-included.
.env
.env.*
!.env.example
!.env.production.example

# Claude Code local working state — never commit.
.claude/

# Ignore OS / editor cruft.
.DS_Store
*.swp
*.swo
.vscode/
.idea/

# Build artifacts.
/public/assets/

# Lead-magnet uploads (CarrierWave local storage). Persisted via the
# docker-compose bind mount in dev; a real volume in production.
/public/uploads/

# RSpec / coverage.
/coverage/
.rspec_status
