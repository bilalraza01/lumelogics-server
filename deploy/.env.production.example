# Production secrets + config for the Lumelogics VPS stack.
#
# Copy to /srv/lumelogics/.env on the server, fill in real values, then
#   chmod 600 /srv/lumelogics/.env
# NEVER commit the filled-in file. docker compose auto-loads it (both for
# ${VAR} interpolation in the compose file and as env_file for web/worker).

# === Postgres (compose interpolates these into the db service + DATABASE_URL) ===
POSTGRES_USER=lumelogics
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=lumelogics_production

# === Rails ===
# Generate: openssl rand -hex 64
SECRET_KEY_BASE=CHANGE_ME
# Generate: ruby -e "require 'securerandom'; puts SecureRandom.hex(64)"
ADMIN_JWT_SECRET=CHANGE_ME
# Seeded admin login (db:seed creates this AdminUser).
ADMIN_EMAIL=bilal@lumelogics.com
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password
# Resend transactional email (verified domain required for real sends).
RESEND_API_KEY=re_xxxxxxxx
MAIL_FROM=Bilal at Lumelogics <bilal@lumelogics.com>
# CORS — the two frontend origins that may call the API from the browser.
ALLOWED_ORIGINS=https://lumelogics.com,https://portal.lumelogics.com
# Where verification / results emails link back to.
FRONTEND_URL=https://lumelogics.com
PLAYER_BASE_URL=https://lumelogics.com/v

# === Caddy ACME registration address ===
ACME_EMAIL=admin@lumelogics.com

# === Frontend build args (NOT secret — public URLs baked at `next build`) ===
NEXT_PUBLIC_ASSESSMENT_API_URL=https://api.lumelogics.com
NEXT_PUBLIC_API_URL=https://api.lumelogics.com
NEXT_PUBLIC_FRONTEND_URL=https://lumelogics.com

# === Outreel video pipeline (OPTIONAL — only if used in production) ===
# Binary paths default correctly inside the image; override only if needed.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lumelogics-videos
R2_PUBLIC_URL=https://videos.lumelogics.com
SMARTLEAD_API_KEY=
SMARTLEAD_API_BASE=https://server.smartlead.ai/api/v1
# YT_DLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
