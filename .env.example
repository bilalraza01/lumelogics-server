# Copy to `.env` and fill in. Loaded automatically by dotenv-rails in
# development/test, and read by docker-compose for both env-substitution
# in the compose file and runtime env on each container.

# Comma-separated list of frontend origins allowed by CORS.
# In development the assessment frontend runs on :4321 (see PORT in
# lumelogics-web). Production should be https://lumelogics.com.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4321

# Random 64+ char string. Used to sign admin JWTs.
# Generate with: ruby -e "require 'securerandom'; puts SecureRandom.hex(64)"
ADMIN_JWT_SECRET=9f76d182bf305b8374bdb6cb7404d85bd899716882b6f2184d1ea6fea8a27874a72f42eeab343816eb57245ccbe170b5ac7453af8413513f4d8bf6ed9a77fc84

# Transactional email via Resend. Get from https://resend.com/api-keys.
# Leave empty during local dev to skip real sends — AssessmentEmailSender
# will log the rendered HTML to stdout instead.
RESEND_API_KEY=re_QFDYCVnb_2yCUz5sWtCJAYEPWENCNSTZW

# "From" address on the results email. Must use a verified Resend domain
# in production. Resend's onboarding sandbox works for testing.
MAIL_FROM=Bilal at Lumelogics <bilal@lumelogics.com>
