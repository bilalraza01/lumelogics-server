# Copy to `.env` and fill in. Loaded automatically by dotenv-rails in
# development/test, and read by docker-compose for both env-substitution
# in the compose file and runtime env on each container.

# Comma-separated list of frontend origins allowed by CORS.
# Dev: marketing :4321, admin portal :3002, Fintagic (Vite) :5173.
# Prod: https://lumelogics.com, https://portal.lumelogics.com, https://fintagic.com.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4321,http://localhost:3002,http://localhost:5173

# Random 64+ char string. Used to sign admin JWTs.
# Generate with: ruby -e "require 'securerandom'; puts SecureRandom.hex(64)"
ADMIN_JWT_SECRET=

# Transactional email via Resend. Get from https://resend.com/api-keys.
# Leave empty during local dev to skip real sends — AssessmentEmailSender
# will log the rendered HTML to stdout instead.
RESEND_API_KEY=

# "From" address on the results email. Must use a verified Resend domain
# in production. Resend's onboarding sandbox works for testing.
#
# NOTE: the Fintagic contact endpoint (/v1/fintagic/contact) sends *to*
# a hardcoded recipient — FintagicContactEmailSender::RECIPIENT — so it's
# not configured here. Change that constant if you ever need to reroute.
MAIL_FROM=Bilal at Lumelogics <bilal@lumelogics.com>

# Single admin user, seeded into the `admin_users` table on `db:seed`.
# Used to log into the admin portal at portal.lumelogics.com.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Outreel: Cloudflare R2 video bucket + Smartlead REST API.
# Required for the AttachVideoJob (Loom → MP4/GIF → R2) and the Smartlead push.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lumelogics-videos
R2_PUBLIC_URL=https://videos.lumelogics.com
PLAYER_BASE_URL=https://lumelogics.com/v
SMARTLEAD_API_KEY=
SMARTLEAD_API_BASE=https://server.smartlead.ai/api/v1
